# 从 ZEGO 控制台获取 AppID 和 ServerSecret
# Get AppID and ServerSecret from ZEGO Console
# https://console.zego.im/
APP_ID=
SERVER_SECRET=

# Token 有效期（秒）/ Token expiration time (seconds)
TOKEN_EXPIRE_SECONDS=3600

# 数字人配置 / Digital Human Configuration
# 从控制台获取数字人 ID / Get Digital Human ID from console
DIGITAL_HUMAN_ID=
