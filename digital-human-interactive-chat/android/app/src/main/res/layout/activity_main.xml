<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="8dp">

    <!-- 标题（极简）/ Title (minimal) -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="2dp"
        android:text="数字人交互聊天\nDigital Human Chat"
        android:textSize="14sp"
        android:textColor="#333333"
        android:gravity="center" />

    <!-- 状态显示（极简）/ Status display (minimal) -->
    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="2dp"
        android:text="Status: waiting..."
        android:textSize="11sp"
        android:gravity="center" />

    <!-- 说明文字 / Note -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:text="正常逻辑是客户端采集用户说话音频后发送至业务后台\nIn normal operation, the client captures user speech audio and sends it to the backend"
        android:textSize="9sp"
        android:textColor="#999999"
        android:gravity="center" />

    <!-- 数字人视频区域（最大化显示）/ Digital human video area (maximized) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#000000">

        <TextureView
            android:id="@+id/remoteVideoView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <!-- 按钮区域（紧凑）/ Button area (compact) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnStartCall"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:textSize="12sp"
            android:text="Start Call\n开始通话"
            android:minHeight="0dp" />

        <Button
            android:id="@+id/btnStopCall"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:enabled="false"
            android:textSize="12sp"
            android:text="Stop Call\n结束通话"
            android:minHeight="0dp" />
    </LinearLayout>

    <!-- 模拟说话按钮（紧凑）/ Simulate talk buttons (compact) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnSimulateTalkZh"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:enabled="false"
            android:textSize="11sp"
            android:text="模拟说话(中文)\nSimulate (ZH)"
            android:minHeight="0dp" />

        <Button
            android:id="@+id/btnSimulateTalkEn"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:enabled="false"
            android:textSize="11sp"
            android:text="模拟说话(英文)\nSimulate (EN)"
            android:minHeight="0dp" />
    </LinearLayout>

</LinearLayout>
